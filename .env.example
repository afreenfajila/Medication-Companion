# Claude is the only reasoning and vision model (label identity text, in-call wording, meaning match).
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-sonnet-5-5). Not a secret.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Realtime speech input: OpenAI Realtime transcription only (no model replies). The browser
# receives a short-lived client secret from /api/voice/openai-session, never this key.
OPENAI_API_KEY=
# Optional: transcription model override (defaults to gpt-live-transcribe). Not a secret.
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
# Speech output: ElevenLabs streaming text-to-speech of the exact visible, approved text. The
# browser receives a single-use token from /api/voice/elevenlabs-token, never this key.
ELEVENLABS_API_KEY=
# On a free account, pick a voice from "My Voices" or a default voice: library voices may be
# refused through the API. The server checks it before minting tokens and falls back if needed.
ELEVENLABS_VOICE_ID=
# Optional: TTS model override (defaults to eleven_flash_v2_5). Not a secret.
ELEVENLABS_TTS_MODEL=
# Without OPENAI_*/ELEVENLABS_* the call uses the browser's own speech engines (labelled as such),
# and without those, text only. No NEXT_PUBLIC_ variable ever carries a key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=http://localhost:3000
# Study mode for failure-injection testing (/study). Local and preview ONLY:
# it is always off when VERCEL_ENV=production, but never set it there anyway.
STUDY_MODE=
# Outside systems (pharmacy, care circle, identity) run through simulated
# services. "simulated" is the only mode. To show the failure states, set
# SIMULATED_SERVICE_FAILURE=pharmacy,care-circle (either or both).
SERVICE_MODE=simulated
SIMULATED_SERVICE_FAILURE=
NEXT_PUBLIC_APP_NAME=Medication Companion
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
